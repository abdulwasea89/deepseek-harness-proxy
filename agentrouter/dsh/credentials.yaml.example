# ~/.dsh/.credentials.yaml — add your AgentRouter API key as a ref
# The key is resolved per request by the harness credential seam. Never commit
# a real key.
version: 1
records:
  client-connection/browser-session:
    kind: grant
    payload:
      version: 1
      secret: REPLACE_WITH_YOUR_BROWSER_SESSION_SECRET
refs:
  DEEPSEEK_API_KEY: sk-REPLACE_WITH_YOUR_DEEPSEEK_KEY
  AGENTROUTER_API_KEY: sk-REPLACE_WITH_YOUR_AGENTROUTER_KEY